\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Estimated $\hat  {I}_{ss}$, correction factor $f_{\mathrm  {HIF}}$, and adaptive TMS $TMS^*$ vs.\ $R_{\!f}$. At the HIF boundary ($R_{\!f}\approx 46\,\Omega $), $f_{\mathrm  {HIF}}$ drops below 0.90 and $K_{\mathrm  {TMS}}^{\mathrm  {eff}}$ switches from 0.12 to 0.08. For deep HIF ($R_{\!f}> 90\,\Omega $), $TMS^*$ clips to $TMS_{\min } = 0.05$. Results consistent with 144-case matrix; analytical curves validated.}}{7}{figure.7}\protected@file@percent }
\newlabel{fig:est_params}{{7}{7}{Estimated $\Iss $, correction factor $\fhif $, and adaptive TMS $\tmss $ vs.\ $\Rf $. At the HIF boundary ($\Rf \approx 46\,\Omega $), $\fhif $ drops below 0.90 and $\Keff $ switches from 0.12 to 0.08. For deep HIF ($\Rf > 90\,\Omega $), $\tmss $ clips to $\tms _{\min } = 0.05$. Results consistent with 144-case matrix; analytical curves validated}{figure.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Composite confidence score $\gamma $ vs.\ $R_{\!f}$. Both 3PH (solid) and SLG (dashed) curves remain above $\gamma _{\min }= 0.80$ throughout the HIF window. For $R_{\!f}> 98\,\Omega $, $\gamma $ falls below threshold, correctly blocking adaptation. Acceptance rates within the HIF window: 3PH~=~\textbf  {93\%}, SLG~=~\textbf  {100\%}. }}{7}{figure.8}\protected@file@percent }
\newlabel{fig:confidence}{{8}{7}{Composite confidence score $\gamma $ vs.\ $\Rf $. Both 3PH (solid) and SLG (dashed) curves remain above $\gammin = 0.80$ throughout the HIF window. For $\Rf > 98\,\Omega $, $\gamma $ falls below threshold, correctly blocking adaptation. Acceptance rates within the HIF window: 3PH~=~\textbf {93\%}, SLG~=~\textbf {100\%}}{figure.8}{}}
