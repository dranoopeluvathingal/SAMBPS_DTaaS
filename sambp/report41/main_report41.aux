\newlabel{sec:studyE}{{5}{3}{Study E --- Two-Bus Microgrid Coordination}{section.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Two-bus IBR microgrid with bus-coupler and dual 87B zones. Bus~A fault (cross symbol): 87B-A detects $I_\mathrm  {diff}=0.80$\,pu and trips Bus~A feeders and the bus-coupler. 87B-B sees $I_\mathrm  {diff}=0$ (external fault) and remains stable. Bus~B continues in service with its two IBR feeders providing islanded voltage/frequency regulation.}}{3}{figure.2}\protected@file@percent }
\newlabel{fig:topology}{{2}{3}{Two-bus IBR microgrid with bus-coupler and dual 87B zones. Bus~A fault (cross symbol): 87B-A detects $I_\mathrm {diff}=0.80$\,pu and trips Bus~A feeders and the bus-coupler. 87B-B sees $I_\mathrm {diff}=0$ (external fault) and remains stable. Bus~B continues in service with its two IBR feeders providing islanded voltage/frequency regulation}{figure.2}{}}
