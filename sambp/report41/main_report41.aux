\@writefile{toc}{\contentsline {section}{\numberline {7}Summary}{3}{section.7}\protected@file@percent }
\newlabel{sec:summary}{{7}{3}{Summary}{section.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Minimum detectable $k_\mathrm  {ibr}$ for each protection element. Lower is more sensitive. OC Group~2 (TR-40, green) is the most sensitive at 0.0075\,pu; 87B-MG (orange) requires $k_\mathrm  {ibr}\geq 0.1176$\,pu. 87B is less sensitive than 87L because the slope constraint requires a larger differential margin. For microgrids with $k_\mathrm  {ibr}\geq 0.20$, all elements are reliably active.}}{4}{figure.3}\protected@file@percent }
\newlabel{fig:sensitivity}{{3}{4}{Minimum detectable $k_\mathrm {ibr}$ for each protection element. Lower is more sensitive. OC Group~2 (TR-40, green) is the most sensitive at 0.0075\,pu; 87B-MG (orange) requires $k_\mathrm {ibr}\geq 0.1176$\,pu. 87B is less sensitive than 87L because the slope constraint requires a larger differential margin. For microgrids with $k_\mathrm {ibr}\geq 0.20$, all elements are reliably active}{figure.3}{}}
