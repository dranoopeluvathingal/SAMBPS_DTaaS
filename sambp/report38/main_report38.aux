\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Dependability $P_\mathrm  {dep}$ versus GFM fleet fraction $f_\mathrm  {gfm}$ ($k_\mathrm  {total}\in [0.06,0.40]$, $N=500$ per scenario). Blue bars: 67Q inactive ($f_\mathrm  {gfm}<0.34$); green bars: 67Q active. All scenarios achieve $P_\mathrm  {dep}=1.000$ because 87L operates independently of control mode. The dashed orange line at $f_\mathrm  {gfm}=0.34$ marks the 67Q activation boundary.}}{4}{figure.3}\protected@file@percent }
\newlabel{fig:coverage}{{3}{4}{Dependability $P_\mathrm {dep}$ versus GFM fleet fraction $f_\mathrm {gfm}$ ($k_\mathrm {total}\in [0.06,0.40]$, $N=500$ per scenario). Blue bars: 67Q inactive ($f_\mathrm {gfm}<0.34$); green bars: 67Q active. All scenarios achieve $P_\mathrm {dep}=1.000$ because 87L operates independently of control mode. The dashed orange line at $f_\mathrm {gfm}=0.34$ marks the 67Q activation boundary}{figure.3}{}}
