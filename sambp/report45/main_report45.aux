\@writefile{toc}{\contentsline {section}{\numberline {3}Study C --- Flag Rate Analysis by Region}{2}{section.3}\protected@file@percent }
\newlabel{sec:studyC}{{3}{2}{Study C --- Flag Rate Analysis by Region}{section.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces DT flag rates (FP and FN) by $k_\mathrm  {ibr}$ region. Structural miss region ($k<0.06$): 18.2\% FP rate --- DT noise occasionally lifts $k_\mathrm  {est}$ above threshold when true $k$ is below. 87L-only region ($0.06\leq k<0.10$): 15.4\% FN rate --- relay trips via 87L but DT estimate falls below 0.06 threshold. Full-scheme region ($k\geq 0.10$): 1.9\% FN rate (noise only).}}{2}{figure.2}\protected@file@percent }
\newlabel{fig:flags}{{2}{2}{DT flag rates (FP and FN) by $k_\mathrm {ibr}$ region. Structural miss region ($k<0.06$): 18.2\% FP rate --- DT noise occasionally lifts $k_\mathrm {est}$ above threshold when true $k$ is below. 87L-only region ($0.06\leq k<0.10$): 15.4\% FN rate --- relay trips via 87L but DT estimate falls below 0.06 threshold. Full-scheme region ($k\geq 0.10$): 1.9\% FN rate (noise only)}{figure.2}{}}
