\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Fault current for mid-line and far-end faults in grid-connected (blue) and islanded (orange) modes at $k_\mathrm  {ibr}=0.20$. The Group~1 pickup at 1.50\,pu (blue dashed line) is visible in the islanded fault level range, confirming sensitivity; the Group~2 pickup at 0.30\,pu (red dashed) provides the required margin for islanded far-end faults. Fault level reduction is 64\% (mid-line) and 72\% (far-end).}}{2}{figure.1}\protected@file@percent }
\newlabel{fig:faultlevels}{{1}{2}{Fault current for mid-line and far-end faults in grid-connected (blue) and islanded (orange) modes at $k_\mathrm {ibr}=0.20$. The Group~1 pickup at 1.50\,pu (blue dashed line) is visible in the islanded fault level range, confirming sensitivity; the Group~2 pickup at 0.30\,pu (red dashed) provides the required margin for islanded far-end faults. Fault level reduction is 64\% (mid-line) and 72\% (far-end)}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces IEC Standard Inverse time-current curves for Group~1 ($I_p=1.50$\,pu, TMS\,$=0.10$, blue) and Group~2 ($I_p=0.30$\,pu, TMS\,$=0.20$, orange). Key operating points are marked: GC mid-line fault at 22.2\,pu (blue circle), IS mid-line at 8.0\,pu (orange square), IS far-end at 4.0\,pu (orange triangle). The Group~2 curve provides appropriate operating times for islanded fault levels.}}{2}{figure.2}\protected@file@percent }
\newlabel{fig:curves}{{2}{2}{IEC Standard Inverse time-current curves for Group~1 ($I_p=1.50$\,pu, TMS\,$=0.10$, blue) and Group~2 ($I_p=0.30$\,pu, TMS\,$=0.20$, orange). Key operating points are marked: GC mid-line fault at 22.2\,pu (blue circle), IS mid-line at 8.0\,pu (orange square), IS far-end at 4.0\,pu (orange triangle). The Group~2 curve provides appropriate operating times for islanded fault levels}{figure.2}{}}
