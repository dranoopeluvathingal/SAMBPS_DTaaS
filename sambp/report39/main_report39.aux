\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces ROCOF versus power mismatch $\Delta P$ for the IBR microgrid ($H_\mathrm  {eq}=0.5$\,s, $f_0=50$\,Hz). The orange dashed line marks the 1\,Hz/s detection threshold (IEEE~1547-2018 \cite  {IEEE_1547_2018}). The red shaded NDZ covers $|\Delta P|<0.02$\,pu (2\% of rated). All physically meaningful mismatches above 2\% produce ROCOF~$>1$\,Hz/s.}}{2}{figure.1}\protected@file@percent }
\newlabel{fig:rocof}{{1}{2}{ROCOF versus power mismatch $\Delta P$ for the IBR microgrid ($H_\mathrm {eq}=0.5$\,s, $f_0=50$\,Hz). The orange dashed line marks the 1\,Hz/s detection threshold (IEEE~1547-2018 \cite {IEEE_1547_2018}). The red shaded NDZ covers $|\Delta P|<0.02$\,pu (2\% of rated). All physically meaningful mismatches above 2\% produce ROCOF~$>1$\,Hz/s}{figure.1}{}}
