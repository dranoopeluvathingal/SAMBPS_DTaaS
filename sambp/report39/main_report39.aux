\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Non-detection zone (NDZ) in load mismatch space. Red rectangle: passive NDZ ($|\Delta P|<0.020$\,pu, $|\Delta Q|<0.050$\,pu). Orange rectangle: combined passive+active NDZ ($|\Delta P|<0.012$\,pu, $|\Delta Q|<0.015$\,pu). Active Q-injection reduces the NDZ area by approximately 87\%. A typical microgrid load mismatch (blue dot) lies well outside both NDZ regions.}}{3}{figure.2}\protected@file@percent }
\newlabel{fig:ndz}{{2}{3}{Non-detection zone (NDZ) in load mismatch space. Red rectangle: passive NDZ ($|\Delta P|<0.020$\,pu, $|\Delta Q|<0.050$\,pu). Orange rectangle: combined passive+active NDZ ($|\Delta P|<0.012$\,pu, $|\Delta Q|<0.015$\,pu). Active Q-injection reduces the NDZ area by approximately 87\%. A typical microgrid load mismatch (blue dot) lies well outside both NDZ regions}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Protection mode switching state machine. Grid-connected mode (left) runs the full scheme from TR-35. On islanding detection at $t=100$\,ms, mode switches within 20\,ms: distance and 87L elements are disabled, overcurrent is rescaled, and GFM inverters assume frequency/voltage regulation. Relay~25 supervises resynchronisation; failure causes lockout.}}{3}{figure.3}\protected@file@percent }
\newlabel{fig:modeswitch}{{3}{3}{Protection mode switching state machine. Grid-connected mode (left) runs the full scheme from TR-35. On islanding detection at $t=100$\,ms, mode switches within 20\,ms: distance and 87L elements are disabled, overcurrent is rescaled, and GFM inverters assume frequency/voltage regulation. Relay~25 supervises resynchronisation; failure causes lockout}{figure.3}{}}
