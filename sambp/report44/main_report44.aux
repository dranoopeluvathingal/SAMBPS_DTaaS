\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces DT $f_\mathrm  {gfm}$ estimate vs true value. Blue circles: DT estimates; grey dashed: perfect estimate. Maximum error 0.027 (at $f_\mathrm  {gfm}=0.50$); all estimates within $\pm 0.03$\,pu. The 67Q activation threshold ($f^*=0.34$, orange dashed) is correctly classified in all six scenarios.}}{3}{figure.2}\protected@file@percent }
\newlabel{fig:fgfm}{{2}{3}{DT $f_\mathrm {gfm}$ estimate vs true value. Blue circles: DT estimates; grey dashed: perfect estimate. Maximum error 0.027 (at $f_\mathrm {gfm}=0.50$); all estimates within $\pm 0.03$\,pu. The 67Q activation threshold ($f^*=0.34$, orange dashed) is correctly classified in all six scenarios}{figure.2}{}}
\@writefile{toc}{\contentsline {section}{\numberline {5}Study E --- DT Cycle Performance}{3}{section.5}\protected@file@percent }
