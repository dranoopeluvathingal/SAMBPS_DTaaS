\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces EKF estimation error [\%] for each state variable after 100 updates (100\,ms) at nominal noise $\sigma _I=0.010$\,pu. $k_\mathrm  {ibr}$ (green): 1.22\%, well within the 5\% target. $\alpha $ (orange): 8.03\%, marginal. $Z_\mathrm  {line}$ (red): 27.3\%, poor --- insufficient observability from sequence-current measurements alone. $f_\mathrm  {gfm}$ (green): 2.71\% via independent $I_2/I_1$ method. Blue dashed line: 5\% protection accuracy target.}}{2}{figure.1}\protected@file@percent }
\newlabel{fig:ekf}{{1}{2}{EKF estimation error [\%] for each state variable after 100 updates (100\,ms) at nominal noise $\sigma _I=0.010$\,pu. $k_\mathrm {ibr}$ (green): 1.22\%, well within the 5\% target. $\alpha $ (orange): 8.03\%, marginal. $Z_\mathrm {line}$ (red): 27.3\%, poor --- insufficient observability from sequence-current measurements alone. $f_\mathrm {gfm}$ (green): 2.71\% via independent $I_2/I_1$ method. Blue dashed line: 5\% protection accuracy target}{figure.1}{}}
