! IEEE 13-Bus Distribution Test Feeder (simplified)
! Source: IEEE Distribution Test Feeder Working Group
! Frequency: 50 Hz, Base: 4.16 kV

Clear
New Circuit.IEEE13 BasekV=115 pu=1.001 Angle=30 frequency=50 phases=3 Mvasc3=20000 Mvasc1=21000

! Substation transformer 115/4.16 kV
New Transformer.T1 phases=3 windings=2
~ wdg=1 bus=sourcebus kV=115 kVA=5000 %r=0.5 X=8
~ wdg=2 bus=650 kV=4.16 kVA=5000 %r=0.5

New Linecode.LC300 nphases=3 r1=0.3061 x1=0.6277 r0=0.7784 x0=1.2084 units=mi
New Linecode.LC301 nphases=3 r1=0.7526 x1=0.1580 r0=1.1765 x0=0.4236 units=mi
New Linecode.LC302 nphases=1 r1=1.3238 x1=0.4033 r0=1.3238 x0=0.4033 units=mi

! Distribution lines
New Line.L650_632  Bus1=650.1.2.3  Bus2=632.1.2.3 LineCode=LC300 Length=2000 units=ft
New Line.L632_633  Bus1=632.1.2.3  Bus2=633.1.2.3 LineCode=LC301 Length=500  units=ft
New Line.L633_634  Bus1=633.1.2.3  Bus2=634.1.2.3 LineCode=LC301 Length=0     ! transformer below
New Line.L632_645  Bus1=632.3.2    Bus2=645.3.2   LineCode=LC302 Length=500  units=ft
New Line.L645_646  Bus1=645.3.2    Bus2=646.3.2   LineCode=LC302 Length=300  units=ft
New Line.L632_671  Bus1=632.1.2.3  Bus2=671.1.2.3 LineCode=LC300 Length=2000 units=ft
New Line.L671_680  Bus1=671.1.2.3  Bus2=680.1.2.3 LineCode=LC300 Length=1000 units=ft
New Line.L671_684  Bus1=671.1.3    Bus2=684.1.3   LineCode=LC302 Length=300  units=ft
New Line.L684_611  Bus1=684.3      Bus2=611.3     LineCode=LC302 Length=300  units=ft
New Line.L684_652  Bus1=684.1      Bus2=652.1     LineCode=LC302 Length=800  units=ft
New Line.L671_692  Bus1=671.1.2.3  Bus2=692.1.2.3 LineCode=LC300 Length=0

! Step-down transformer 4.16/0.48 kV at bus 634
New Transformer.T634 phases=3 windings=2
~ wdg=1 bus=633 kV=4.16 kVA=500 %r=0.5 X=4.3
~ wdg=2 bus=634 kV=0.48 kVA=500 %r=0.5

! Loads
New Load.L634a Bus1=634.1 Phases=1 kV=0.277 kW=160 kvar=110 Model=1
New Load.L634b Bus1=634.2 Phases=1 kV=0.277 kW=120 kvar=90  Model=1
New Load.L634c Bus1=634.3 Phases=1 kV=0.277 kW=120 kvar=90  Model=1
New Load.L645  Bus1=645.2 Phases=1 kV=2.4   kW=170 kvar=125 Model=1
New Load.L646  Bus1=646.2 Phases=1 kV=2.4   kW=230 kvar=132 Model=2
New Load.L652  Bus1=652.1 Phases=1 kV=2.4   kW=128 kvar=86  Model=2
New Load.L671  Bus1=671   Phases=3 kV=4.16  kW=385 kvar=220 Model=1
New Load.L692  Bus1=692.3 Phases=1 kV=2.4   kW=170 kvar=151 Model=5
New Load.L611  Bus1=611.3 Phases=1 kV=2.4   kW=170 kvar=80  Model=5
New Load.L680  Bus1=680   Phases=3 kV=4.16  kW=0   kvar=0

! Capacitors
New Capacitor.C611 Bus1=611.3 phases=1 kvar=100 kV=2.4
New Capacitor.C675 Bus1=671   phases=3 kvar=600 kV=4.16

Set Voltagebases=[115, 4.16, 0.48]
Calcvoltagebases
Solve
