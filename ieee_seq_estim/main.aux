\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Architecture comparison. \textit  {Left}: Stage~1 phase-domain estimator fits a single 6-parameter model to phase~A current. The red dashed block highlights the unmodelled phase-B/C residual for asymmetric faults. \textit  {Right}: proposed sequence-domain estimator decomposes three-phase currents by Hilbert--Fortescue, routes active sequences to independent LM estimators, and selects the positive-sequence result $\hat  {\bm  {\theta }}^{(1)}$ for relay adaptation.}}{5}{figure.1}\protected@file@percent }
\newlabel{fig:arch}{{1}{5}{Architecture comparison. \textit {Left}: Stage~1 phase-domain estimator fits a single 6-parameter model to phase~A current. The red dashed block highlights the unmodelled phase-B/C residual for asymmetric faults. \textit {Right}: proposed sequence-domain estimator decomposes three-phase currents by Hilbert--Fortescue, routes active sequences to independent LM estimators, and selects the positive-sequence result $\hat {\bm \theta }^{(1)}$ for relay adaptation}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Sequence networks for the study system and fault-type interconnections. For LL faults (left connection): positive and negative networks are placed in series ($I_1 = I_2$, $I_0 = 0$); the different impedances $Z_1$ and $Z_2$ cause different transient time constants. For SLG faults (right connection): all three networks are in series ($I_1 = I_2 = I_0$); the large zero-sequence impedance $Z_0$ reduces the total fault current compared with LL.}}{5}{figure.2}\protected@file@percent }
\newlabel{fig:seqnet}{{2}{5}{Sequence networks for the study system and fault-type interconnections. For LL faults (left connection): positive and negative networks are placed in series ($I_1 = I_2$, $I_0 = 0$); the different impedances $Z_1$ and $Z_2$ cause different transient time constants. For SLG faults (right connection): all three networks are in series ($I_1 = I_2 = I_0$); the large zero-sequence impedance $Z_0$ reduces the total fault current compared with LL}{figure.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {VIII-D}}D. Line-to-Line Fault: Sequence Waveform Fitting}{5}{subsection.8.4}\protected@file@percent }
\newlabel{sec:results:ll}{{\mbox  {VIII-D}}{5}{D. Line-to-Line Fault: Sequence Waveform Fitting}{subsection.8.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Sequence-component inverse-estimation and relay update algorithm. The fault-type selector routes to either the balanced estimator (3PH) or the sequence estimators (LL/SLG/LLG). For negative- and zero-sequence channels, a symmetry check prevents fitting of noise-dominated signals. The relay update always uses the positive-sequence estimate $\hat  {\bm  {\theta }}^{(1)}$.}}{6}{figure.3}\protected@file@percent }
\newlabel{fig:flowchart}{{3}{6}{Sequence-component inverse-estimation and relay update algorithm. The fault-type selector routes to either the balanced estimator (3PH) or the sequence estimators (LL/SLG/LLG). For negative- and zero-sequence channels, a symmetry check prevents fitting of noise-dominated signals. The relay update always uses the positive-sequence estimate $\hat {\bm \theta }^{(1)}$}{figure.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {VIII-E}}E. Single-Line-to-Ground Fault: Propagation Verification}{6}{subsection.8.5}\protected@file@percent }
\newlabel{sec:results:slg}{{\mbox  {VIII-E}}{6}{E. Single-Line-to-Ground Fault: Propagation Verification}{subsection.8.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces LL fault: positive sequence $I_1(t)$ (top) and negative sequence $I_2(t)$ (bottom). Blue solid: measured. Red dashed: Stage~1 (phase-A-only) fit projected onto sequence domain--- the phase-A model captures an averaged time constant and cannot represent the faster-decaying $I_2$. Green dotted: proposed sequence estimator---near-perfect reconstruction of both $I_1$ and $I_2$ independently.}}{6}{figure.4}\protected@file@percent }
\newlabel{fig:ll_waveforms}{{4}{6}{LL fault: positive sequence $I_1(t)$ (top) and negative sequence $I_2(t)$ (bottom). Blue solid: measured. Red dashed: Stage~1 (phase-A-only) fit projected onto sequence domain--- the phase-A model captures an averaged time constant and cannot represent the faster-decaying $I_2$. Green dotted: proposed sequence estimator---near-perfect reconstruction of both $I_1$ and $I_2$ independently}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces SLG fault: sequence components $I_1, I_2, I_0$ (top) and phase-current reconstruction (bottom). Top: $I_1$ is fitted; $I_2$ and $I_0$ are propagated and overlap $I_1$ as expected from $I_1=I_2=I_0$. Bottom: phase~A current $i_a = 3I_1$ is accurately reconstructed by both Stage~1 and the proposed method; the key difference is that the proposed method explicitly confirms the sequence-network equality and predicts the near-zero $i_b$, $i_c$.}}{6}{figure.5}\protected@file@percent }
\newlabel{fig:slg_waveforms}{{5}{6}{SLG fault: sequence components $I_1, I_2, I_0$ (top) and phase-current reconstruction (bottom). Top: $I_1$ is fitted; $I_2$ and $I_0$ are propagated and overlap $I_1$ as expected from $I_1=I_2=I_0$. Bottom: phase~A current $i_a = 3I_1$ is accurately reconstructed by both Stage~1 and the proposed method; the key difference is that the proposed method explicitly confirms the sequence-network equality and predicts the near-zero $i_b$, $i_c$}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Jacobian condition number $\kappa _n$ for Stage~1 (red) and the proposed sequence estimator (blue). The orange dashed threshold at $\kappa _{\max } = 20$ marks the confidence-gate limit; above this the relay update is rejected. Stage~1 exceeds the threshold for all asymmetric fault types (LL, SLG, LLG), producing frequent low-$\gamma $ rejections. The sequence estimator remains below the threshold for all cases.}}{7}{figure.6}\protected@file@percent }
\newlabel{fig:conditioning}{{6}{7}{Jacobian condition number $\kappa _n$ for Stage~1 (red) and the proposed sequence estimator (blue). The orange dashed threshold at $\kappa _{\max } = 20$ marks the confidence-gate limit; above this the relay update is rejected. Stage~1 exceeds the threshold for all asymmetric fault types (LL, SLG, LLG), producing frequent low-$\gamma $ rejections. The sequence estimator remains below the threshold for all cases}{figure.6}{}}
